# Web3Guard API keys. The scanner tries providers in priority order
# (NIM -> OpenRouter -> Groq -> DeepSeek) and falls through on
# missing / failed keys. Set at least one.

# NVIDIA NIM (free tier: 35 req/min)
NIM_API_KEY=

# OpenRouter (cheapest paid DeepSeek: $0.14 / 1M in)
OPENROUTER_API_KEY=

# Groq (fast, Llama 3.3 70B)
GROQ_API_KEY=

# DeepSeek direct
DEEPSEEK_API_KEY=

# OpenAI (paid; not on the default provider list)
OPENAI_API_KEY=

# --- Telegram bot (python -m web3guard.telegram_bot) ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to trigger scans (empty = allow all)
ALLOWED_CHAT_IDS=
# Token budget clamp per scan (default 200000)
WEB3GUARD_MAX_BUDGET=200000

# Anthropic
ANTHROPIC_API_KEY=

# Optional: a mainnet RPC URL for fork-based PoCs.
# WEB3GUARD_FORK_URL=https://eth-mainnet.g.alchemy.com/v2/your-key
